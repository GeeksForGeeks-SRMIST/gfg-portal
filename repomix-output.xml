  for (const member of members) {
    try {
      // 1. Attempt to create Auth user (skips creation notice if already registered)
      const { error: authError } = await supabaseAdmin.auth.admin.createUser({
        email: member.email,
        password: 'Geeks@2026',
        email_confirm: true,
        user_metadata: { role: member.role, full_name: member.full_name }
      });

      if (authError && !authError.message.includes('already registered')) {
        console.error(`Auth creation note for ${member.email}:`, authError.message);
      }

      // 2. Always upsert the record into the club_members table
      const { error: dbError } = await (supabaseAdmin
        .from('club_members') as any)
        .upsert(member, { onConflict: 'email' });

      if (dbError) {
        console.error(`Failed to sync profile for ${member.email}:`, dbError.message);
      } else {
        console.log(`Successfully synced database record: ${member.full_name} (${member.email})`);
      }
    } catch (err) {
      console.error(`Error processing ${member.email}:`, err);
    }
  }

  console.log('Synchronization complete!');
}

