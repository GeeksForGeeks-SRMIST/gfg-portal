      )}

      {/* TAB 2: TEAM'S COMPLAINTS QUEUE (EXECUTIVE ADMIN ONLY) */}
      {activeTab === "team" && isExecutiveAdmin && (
        <div className="space-y-4">
          {teamComplaints.length === 0 ? (
            <div className="neo-flat rounded-2xl p-12 text-center opacity-50 space-y-2">
